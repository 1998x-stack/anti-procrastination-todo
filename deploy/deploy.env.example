# Start-First server-local deployment example (non-executable KEY=value file).
# Review the EXISTING $SF_DEPLOY_ROOT/deploy.env before copying a template.
# Do not overwrite deliberately authorized existing LAN settings without a plan.
# Allowed keys: SF_BIND, SF_PORT, SF_URL. Explicit env vars take precedence.
#
# Recommended default: loopback only. Use authenticated SSH tunnel or an HTTPS proxy.
SF_BIND=127.0.0.1
SF_PORT=8081
SF_URL=http://127.0.0.1:8081

# Optional only after authorization AND firewall/network inspection:
# SF_BIND=0.0.0.0
# WARNING: 0.0.0.0 means ALL IPv4 interfaces, including future public ones.
# HTTP network attackers can replace JS and read browser IndexedDB even though
# the genuine application never uploads task text.
#
# A specific LAN address MUST be static; DHCP changes can break Docker startup.
# SF_BIND=127.0.0.1 192.168.1.100
